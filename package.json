{
  "name": "copilote-trading",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Copilote de trading crypto et forex : analyse de captures, dimensionnement du risque, journal et memoire qui s'adapte.",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "contexte": "tsx scripts/contexte.ts",
    "risque": "tsx scripts/risque.ts",
    "decision": "tsx scripts/decision.ts",
    "resultat": "tsx scripts/resultat.ts",
    "bilan": "tsx scripts/bilan.ts",
    "veille": "tsx scripts/veille.ts",
    "simulation": "tsx scripts/simulation.ts",
    "tableau": "tsx scripts/tableau.ts",
    "tableau:html": "tsx scripts/tableau.ts --html"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
